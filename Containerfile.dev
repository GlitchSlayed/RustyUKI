FROM registry.fedoraproject.org/fedora:45

RUN dnf install -y \
    bash \
    cargo \
    rust \
    gcc \
    coreutils \
    diffutils \
    findutils \
    grep \
    sed \
    util-linux \
    which \
    git \
    dracut \
    systemd-ukify \
    efibootmgr \
    systemd-boot \
    binutils \
    rpm-build \
    rpmdevtools \
    systemd-rpm-macros \
 && dnf clean all

WORKDIR /workspace
